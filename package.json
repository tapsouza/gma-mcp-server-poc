{
  "name": "gma-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing curated GMA catalogue tools to AI agents",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "bin": {
    "gma-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
