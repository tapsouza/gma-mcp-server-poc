# GMA MCP Server — environment configuration
#
# Every value below is ILLUSTRATIVE. Never commit a real host, a real
# authorization-server id, or any token to this file (constitution Principle V).
# Configuration is read and validated ONCE at startup; a missing required value
# makes the process refuse to start rather than fail at first request (FR-019).

# --- Required ---

# Base URL of the GMA (GBP Management API) instance to call.
# One deployed MCP instance per GMA environment — this is NEVER a tool argument.
GMA_BASE_URL=https://gma.example-nonprod.invalid

# Comma-separated brand instance codes used when a tool supplies no `instances`
# override. Agents discover valid codes via the `list_instances` tool (FR-017).
GMA_DEFAULT_INSTANCES=PP,BF

# The OKTA issuer this deployment accepts. GMA's issuer is a PER-ENVIRONMENT
# custom authorization server, so a token is valid against exactly one GMA
# environment. Never widen this set, and never hardcode it in source.
OKTA_ISSUER=https://example.okta.invalid/oauth2/aus0000000000000000

# --- Optional (defaults shown) ---

# Per-GMA-request timeout in milliseconds.
GMA_TIMEOUT_MS=30000

# Above this match count, `find_catalogue_entity` reports `tooBroad` with a
# narrowing hint instead of returning a candidate list (FR-015).
GMA_MAX_CANDIDATES=25

# One of: debug | info | warn | error
LOG_LEVEL=info
