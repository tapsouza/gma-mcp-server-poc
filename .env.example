# GMA MCP Server — environment configuration
#
# Every value below is ILLUSTRATIVE. Never commit a real host, a real
# authorization-server id, or any token to this file (constitution Principle V).
# Configuration is read and validated ONCE at startup; a missing required value
# makes the process refuse to start rather than fail at first request (FR-019).

# --- Required ---

# Base URL of the GMA (GBP Management API) instance to call.
# One deployed MCP instance per GMA environment — this is NEVER a tool argument.
GMA_BASE_URL=https://gma.example-nonprod.invalid

# Comma-separated brand instance codes used when a tool supplies no `instances`
# override. Agents discover valid codes via the `list_instances` tool (FR-017).
GMA_DEFAULT_INSTANCES=urn:i:FD:US-MA,urn:i:FD:US-WV,urn:i:FD:US-WY,urn:i:FD:US-MD,urn:i:FD:US-FD,urn:i:FD:US-AZ,urn:i:FD:US-CO,urn:i:FD:US-CT,urn:i:FD:US-DC,urn:i:FD:US-FL,urn:i:FD:US-GA,urn:i:FD:US-HI,urn:i:FD:US-NJ1,urn:i:FD:US-ID,urn:i:FD:US-IL,urn:i:FD:US-IN,urn:i:FD:US-IA,urn:i:FD:US-KS,urn:i:FD:US-KY,urn:i:FD:US-LA,urn:i:FD:US-ME,urn:i:FD:US-MI,urn:i:FD:US-MR,urn:i:FD:US-NJ,urn:i:FD:US-NY,urn:i:FD:US-NC,urn:i:FD:US-OH,CA-ON,urn:i:FD:US-PA,urn:i:FD:US-PF,urn:i:FD:US-PR,urn:i:FD:US-TN,urn:i:FD:US-TX,urn:i:FD:US-VT,urn:i:FD:US-VA

# The OKTA issuer this deployment accepts. GMA's issuer is a PER-ENVIRONMENT
# custom authorization server, so a token is valid against exactly one GMA
# environment. Never widen this set, and never hardcode it in source.
OKTA_ISSUER=https://example.okta.invalid/oauth2/aus0000000000000000

# --- Optional (defaults shown) ---

# Per-GMA-request timeout in milliseconds.
GMA_TIMEOUT_MS=30000

# Above this match count, `find_catalogue_entity` reports `tooBroad` with a
# narrowing hint instead of returning a candidate list (FR-015).
GMA_MAX_CANDIDATES=25

# Maximum bets `find_customer_bets` returns. Reaching the cap is REPORTED in the
# result (`limitReached: true`), never silently truncated (Principle V, FR-010).
CUSTOMER_MAX_BETS=20

# Maximum distinct catalogue positions `get_bet_risk_context` resolves for one bet.
# This is a CORRECTNESS bound, not a performance target: reaching it names the
# unresolved legs via each leg's `resolution` and marks the result incomplete
# (FR-023). A bet's distinct events are deduplicated before this bound applies.
CUSTOMER_MAX_EVENT_RESOLUTIONS=10

# One of: debug | info | warn | error
LOG_LEVEL=info

# --- The operator's identity ---

# The access token forwarded to GMA, unaltered. The server reads it PER INVOCATION
# under stdio, which has no HTTP request to carry a bearer (Principle I, development
# only). Never commit a real token.
#
# Running the server directly (`npm run dev`): required.
# Running the local agent harness (`npm run agent`): OPTIONAL — when set it is used
# verbatim and wins over any stored credential, and when unset the harness signs in
# interactively and supplies the token to the server itself.
# GMA_USER_TOKEN=paste-an-access-token-here

# --- Local agent harness only (npm run agent) ---
#
# Read by the LOCAL DEVELOPMENT HARNESS under agent/, and none of them is forwarded to
# the server process — its narrow audited input set is the point of src/core/config.ts.
# The server's configuration above is unaffected by all of them.
# See specs/002-local-cli-agent/contracts/config.md for the full forwarding contract.

# Client id of an OKTA NATIVE application with the Device Authorization and Refresh
# Token grants enabled, on the same authorization server as OKTA_ISSUER above. Needed
# ONLY for interactive sign-in; the harness runs without it when GMA_USER_TOKEN is set.
# OKTA_CLIENT_ID=0oaexampleclientid00000

# Bedrock model the harness drives. Model access is granted per AWS account, so the
# default is a starting guess: a 403 is fixed by setting this, not by changing code.
# Defaults to us.anthropic.claude-sonnet-5.
# AGENT_MODEL_ID=us.anthropic.claude-sonnet-5

# AWS region and credentials for Bedrock. Read by the model provider and NEVER passed
# to the server process — its audited input set is the point of src/core/config.ts.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAEXAMPLEKEYID00000
AWS_SECRET_ACCESS_KEY=an-example-secret-access-key-not-a-real-one
# Only when using SSO / temporary credentials.
# AWS_SESSION_TOKEN=an-example-session-token
